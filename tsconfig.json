{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2020",
		"lib": ["ES2022"],
		"esModuleInterop": true,
		"declaration": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"newLine": "LF",
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"incremental": true,
		"strict": true,
		"jsx": "react-jsx",
		"noFallthroughCasesInSwitch": true,
		"strictPropertyInitialization": false,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src"]
}
